{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin"
      }
    ],
    "assets": [
      {
        "include": "infrastructure/providers/mail/templates/**/*",
        "watchAssets": true
      },
      {
        "include": "modules/service-order/pdf/assets/**/*",
        "watchAssets": true
      }
    ]
  }
}
